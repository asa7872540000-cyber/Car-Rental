
<html>
<head>
    
    <title>إنشاء حساب جديد</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-sm bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
        
        <div id="alertBox" class="hidden mb-5 p-3 rounded-xl text-xs font-medium text-center transition-all"></div>

        <div id="registerFormSection">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-slate-900 mb-1">حساب جديد</h1>
                <p class="text-xs text-slate-400">أدخل بياناتك لإنشاء حساب جديد في دقائق</p>
            </div>

            <form onsubmit="handleRegister(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">الاسم الكامل</label>
                    <input type="text" id="regName" required placeholder=""
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-slate-400 focus:bg-white transition-all">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">البريد الإلكتروني</label>
                    <input type="email" id="regEmail" required placeholder="name@example.com"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-slate-400 focus:bg-white transition-all">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">كلمة المرور</label>
                    <input type="password" id="regPass" required placeholder="••••••••"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-slate-400 focus:bg-white transition-all">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">تأكيد كلمة المرور</label>
                    <input type="password" id="regPassConfirm" required placeholder="••••••••"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-slate-400 focus:bg-white transition-all">
                </div>

                <button type="submit" 
                    class="w-full py-2.5 mt-2 bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm rounded-xl transition-colors shadow-sm active:scale-[0.99]">
                    إنشاء الحساب
                </button>
            </form>

            <div class="mt-6 text-center text-xs text-slate-500">
                لديك حساب بالفعل؟ 
                <button type="button" onclick="toggleForm('login')" class="text-slate-900 font-semibold hover:underline mr-1 focus:outline-none">تسجيل الدخول</button>
            </div>
        </div>

        <div id="loginFormSection" class="hidden">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-slate-900 mb-1">تسجيل الدخول</h1>
                <p class="text-xs text-slate-400">مرحباً بك مجدداً، أدخل بياناتك للمتابعة</p>
            </div>

            <form onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">البريد الإلكتروني</label>
                    <input type="email" required placeholder="name@example.com"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-slate-400 focus:bg-white transition-all">
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="text-xs font-semibold text-slate-600">كلمة المرور</label>
                        <a href="#" onclick="showAlert('تم إرسال رابط استعادة كلمة المرور لبريدك', 'info'); return false;" class="text-xs text-slate-400 hover:text-slate-700 transition-colors">نسيت كلمة المرور؟</a>
                    </div>
                    <input type="password" required placeholder="••••••••"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-slate-400 focus:bg-white transition-all">
                </div>

                <button type="submit" 
                    class="w-full py-2.5 mt-2 bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm rounded-xl transition-colors shadow-sm active:scale-[0.99]">
                    تسجيل الدخول
                </button>
            </form>

            <div class="mt-6 text-center text-xs text-slate-500">
                ليس لديك حساب؟ 
                <button type="button" onclick="toggleForm('register')" class="text-slate-900 font-semibold hover:underline mr-1 focus:outline-none">إنشاء حساب جديد</button>
            </div>
        </div>

    </div>

    <script>
        function toggleForm(type) {
            const loginForm = document.getElementById('loginFormSection');
            const registerForm = document.getElementById('registerFormSection');
            const alertBox = document.getElementById('alertBox');

            alertBox.classList.add('hidden');

            if (type === 'register') {
                loginForm.classList.add('hidden');
                registerForm.classList.remove('hidden');
            } else {
                registerForm.classList.add('hidden');
                loginForm.classList.remove('hidden');
            }
        }

        function showAlert(msg, type = 'success') {
            const alertBox = document.getElementById('alertBox');
            alertBox.innerText = msg;
            alertBox.classList.remove('hidden');

            if (type === 'success') {
                alertBox.className = "mb-5 p-3 rounded-xl text-xs font-medium text-center bg-emerald-50 text-emerald-700 border border-emerald-100";
            } else if (type === 'error') {
                alertBox.className = "mb-5 p-3 rounded-xl text-xs font-medium text-center bg-rose-50 text-rose-700 border border-rose-100";
            } else {
                alertBox.className = "mb-5 p-3 rounded-xl text-xs font-medium text-center bg-slate-100 text-slate-700 border border-slate-200";
            }
        }

        function handleRegister(e) {
            e.preventDefault();
            const pass = document.getElementById('regPass').value;
            const passConfirm = document.getElementById('regPassConfirm').value;

            if (pass !== passConfirm) {
                showAlert('كلمتا المرور غير متطابقتين!', 'error');
                return;
            }

            showAlert('تم إنشاء الحساب بنجاح! مرحباً بك.', 'success');
        }

        function handleLogin(e) {
            e.preventDefault();
            showAlert('تم تسجيل الدخول بنجاح!', 'success');
        }
    </script>
</body>
</html>
